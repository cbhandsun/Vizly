      "domainClass": "be-logistics",
      "type": "custom",
      "zIndex": 1
    },
    {
      "id": "cost-allocation-billing",
      "description": "<b>成本分摊与计费</b><br/>按订单/部门/客户分摊运输成本<br/><i>生成计费依据</i>",
      "domain": "final-output",
      "domainClass": "be-logistics",
      "type": "custom",
      "zIndex": 1
    },
    {
      "id": "export-to-tms",
      "description": "<b>推送至TMS/WMS</b><br/>计划下发, 执行状态双向同步",
      "domain": "final-output",
      "domainClass": "be-logistics",
      "type": "custom",
      "zIndex": 1
    }
