      "domainClass": "ch",
      "type": "custom",
      "zIndex": 1
    },
    {
      "id": "publish-plan",
      "description": "<b>发布执行计划</b><br/>冻结计划版本, 通知所有相关方",
      "domain": "final-output",
      "domainClass": "be-logistics",
      "type": "custom",
      "zIndex": 1
