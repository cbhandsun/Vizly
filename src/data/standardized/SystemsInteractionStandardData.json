  },
  "config": {
    "NODE_WIDTH": 280,
    "NODE_HEIGHT": 120,
    "NODE_PADDING": {
      "horizontal": 60,
      "vertical": 80
    },
    "SPACING": {
      "H": 140,
      "V": 100
    },
    "Z_EDGE": {
      "MAIN": 20,
      "DATA": 10,
      "FEEDBACK": 5
    }
  },
  "metadata": {
    "title": "系统交互架构图",
    "description": "系统交互架构图，展示了OMS、WMS、TMS等核心系统之间的数据流和业务交互",
    "author": "Systems Architecture Team",
    "createdAt": "2024-01-01T00:00:00.000Z",
