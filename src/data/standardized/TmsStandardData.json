      "domainClass": "ch",
      "type": "custom",
      "zIndex": 1
    },
    {
      "id": "logistics-oms",
      "description": "<b>物流订单中心 (Orchestrator)</b><br/>• 订单聚合与分发<br/>• 履约网络编排 (寻源/拆合单)<br/>• 全程状态监控",
      "domain": "logistics",
      "domainClass": "be-logistics",
      "type": "custom",
      "zIndex": 1
    },
    {
      "id": "wms-inbound",
      "description": "<b>WMS-收货与存储</b><br/>• ASN 预约/收货上架<br/>• 库内补货/存储",
      "domain": "wms",
      "domainClass": "be-scm",
      "type": "custom",
      "zIndex": 1
    },
    {
      "id": "wms-outbound",
      "description": "<b>WMS-履行与出库</b><br/>• 接收出库指令/波次计划<br/>• 包装/集货/月台集货",
      "domain": "wms",
      "domainClass": "be-scm",
      "type": "custom",
      "zIndex": 1
    },
    {
