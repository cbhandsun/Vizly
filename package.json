{
  "name": "vizly-app",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=22.23.4 <23",
    "npm": ">=12 <13"
  },
  "scripts": {
    "dev": "vite",
    "collaboration:build": "tsc -p server/tsconfig.build.json",
    "collaboration:auth-load": "npm run collaboration:build && node scripts/check-collaboration-auth-load.mjs",
    "collaboration:mixed-load": "npm run collaboration:build && node scripts/check-collaboration-mixed-load.mjs",
    "test:telemetry": "npm run collaboration:build && node scripts/check-telemetry-storage.mjs",
    "collaboration:start": "node --env-file-if-exists=.env.collaboration.local dist-collaboration/index.js",
    "check": "node scripts/run-check.mjs",
    "build": "vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:ci --",
    "test:ci": "vitest run --pool=forks --maxWorkers=2",
    "test:full": "npm run test:ci --",
    "test:e2e": "playwright test && playwright test --config playwright.recovery.config.ts && npm run test:s3:browser",
    "test:e2e:main": "playwright test",
    "test:e2e:compatibility": "playwright test --config playwright.compatibility.config.ts",
    "test:e2e:recovery": "playwright test --config playwright.recovery.config.ts",
    "test:e2e:s3": "npm run test:s3:browser",
    "test:database": "node scripts/check-database-paths.mjs",
    "test:rls": "node scripts/check-rls-regression.mjs",
    "test:s3": "node scripts/check-s3-integration.mjs",
    "test:s3:browser": "node scripts/check-s3-browser-integration.mjs",
    "lint": "eslint . --max-warnings=0 --cache --cache-strategy content --cache-location node_modules/.cache/vizly-eslint",
    "preview": "vite preview",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "audit:all": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.58",
    "@ai-sdk/google": "4.0.76",
    "@ai-sdk/openai": "4.0.71",
    "@ai-sdk/openai-compatible": "3.0.53",
    "@ant-design/icons": "6.3.2",
    "@iconify/react": "6.0.2",
    "@monaco-editor/react": "4.7.0",
    "@react-three/fiber": "9.6.1",
    "@reogrid/font-sc": "1.0.1",
    "@supabase/server": "1.7.0",
    "@supabase/supabase-js": "2.111.0",
    "@types/d3-force": "3.0.10",
    "@types/dagre": "0.7.54",
    "@vercel/functions": "3.10.5",
    "@vercel/oidc": "4.0.4",
    "@vizly/contracts": "file:vendor/vizly-contracts-0.1.0-alpha.3-e05b95e8354c0bde.tgz",
    "@vizly/core": "file:vendor/vizly-core-0.1.0-alpha.20-b2dd197696c4d53c.tgz",
    "@xyflow/react": "12.11.2",
    "ai": "7.0.107",
    "antd": "6.5.2",
    "d3-force": "3.0.0",
    "dagre": "0.8.5",
    "elkjs": "0.12.0",
    "fast-json-patch": "3.1.1",
    "gifshot": "0.4.5",
    "html-to-image": "1.11.13",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "immer": "11.1.15",
    "jspdf": "4.2.1",
    "jszip": "3.10.1",
    "lib0": "0.2.118",
    "lucide-react": "1.27.0",
    "marked": "18.0.7",
    "mind-elixir": "5.14.0",
    "next-themes": "0.4.6",
    "perfect-freehand": "1.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.2",
    "react-i18next": "17.0.11",
    "react-icons": "5.7.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.2",
    "react-resize-detector": "12.3.0",
    "react-router": "8.3.0",
    "rehype-highlight": "7.0.2",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "roughjs": "4.6.6",
    "svg2pdf.js": "2.8.1",
    "three": "0.185.1",
    "web-worker": "1.5.0",
    "ws": "8.21.1",
    "y-protocols": "1.0.7",
    "y-websocket": "3.0.0",
    "yjs": "13.6.31",
    "zod": "4.6.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@types/ws": "8.18.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fast-png": "6.4.0",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.6",
    "vitest": "4.1.12"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "nanoid": "^3.3.18",
    "undici": "7.30.1",
    "source-map-js": "1.2.2",
    "@vercel/cli-config": {
      "zod": "4.6.7"
    },
    "minimatch": "11.0.1"
  }
}
