{
  "name": "vizly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache",
    "typecheck": "tsc --noEmit --pretty false",
    "verify": "npm run check:artifacts && npm run check:secrets && npm run typecheck && npm run lint && npm run build && npm run check:bundle",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "npm run check:test-ci-coverage && node scripts/run-test-ci.mjs",
    "test:ci:node": "vitest run --maxWorkers=2 --environment=node supabase/__tests__ src/core/algorithms/__tests__ src/core/workers/preprocessing/__tests__ src/core/workers/postprocessing/__tests__",
    "test:ci:dom-base": "npm run test:ci:dom-utils && npm run test:ci:dom-services && npm run test:ci:dom-workers",
    "test:ci:dom-utils": "npm run test:ci:dom-utils-security && npm run test:ci:dom-utils-storage && npm run test:ci:dom-utils-import && npm run test:ci:dom-utils-layout && npm run test:ci:dom-utils-misc && npm run test:ci:dom-utils-app",
    "test:ci:dom-utils-security": "vitest run --maxWorkers=2 src/core/utils/__tests__/CryptoService.test.ts src/core/utils/__tests__/globalErrorHandler.test.ts src/core/utils/__tests__/errorLogger.test.ts src/core/utils/__tests__/Logger.test.ts src/core/utils/__tests__/sanitizeHtml.test.ts src/core/utils/__tests__/remoteDiagramPreview.test.ts src/core/utils/__tests__/remoteTemplateMetadata.test.ts src/core/utils/__tests__/logSecurity.test.ts src/core/utils/__tests__/consoleCleanup.test.ts src/core/utils/__tests__/downloadUtils.test.ts src/core/utils/__tests__/exportTextSecurity.test.ts src/core/utils/__tests__/iconifySecurity.test.ts",
    "test:ci:dom-utils-storage": "vitest run --maxWorkers=2 src/core/utils/__tests__/diagramTypeStorage.test.ts src/core/utils/__tests__/customPresetStorage.test.ts src/core/utils/__tests__/templateUtils.test.ts src/core/utils/__tests__/nodeTemplateStorage.test.ts src/core/utils/__tests__/layerStorage.test.ts src/core/utils/__tests__/minimapOverlayStorage.test.ts src/core/utils/__tests__/diagramMenuStorage.test.ts src/core/utils/__tests__/autoSaveStorage.test.ts src/core/utils/__tests__/layoutStorage.test.ts src/core/utils/__tests__/nodeValidation.test.ts",
    "test:ci:dom-utils-import": "vitest run --maxWorkers=2 src/core/utils/__tests__/flowchartClipboard.test.ts src/core/utils/__tests__/diagramJsonImport.test.ts src/core/utils/__tests__/coerceDiagram.test.ts src/core/utils/__tests__/fileImportGuards.test.ts src/core/utils/__tests__/dragDropPayload.test.ts src/core/utils/__tests__/imageExporter.test.ts",
    "test:ci:dom-utils-layout": "vitest run --maxWorkers=2 src/core/utils/__tests__/LayoutAlgorithms.test.ts src/core/utils/__tests__/EnhancedTextMeasurement.test.ts src/core/utils/__tests__/cssVariables.test.ts src/core/utils/__tests__/colorUtils.test.ts src/core/utils/__tests__/domainKey.test.ts",
    "test:ci:dom-utils-misc": "vitest run --maxWorkers=2 src/core/utils/__tests__/mermaidConverter.test.ts src/core/utils/__tests__/clearFlowchartCache.test.ts src/core/utils/__tests__/dateOnly.test.ts src/core/utils/__tests__/formatRelativeTime.test.ts",
    "test:ci:dom-utils-app": "vitest run --maxWorkers=2 src/components/ai/__tests__ src/data/__tests__",
    "test:ci:dom-services": "vitest run --maxWorkers=2 src/services/__tests__ src/services/ai/__tests__",
    "test:ci:dom-workers": "vitest run --maxWorkers=2 src/core/workers/__tests__ src/core/workers/core/__tests__",
    "test:ci:context": "vitest run --maxWorkers=2 src/context/__tests__",
    "test:ci:ui": "vitest run --maxWorkers=2 src/app/__tests__ src/pages/__tests__ src/components/__tests__ src/components/ui/__tests__ src/components/layout/__tests__ src/components/shared/__tests__ src/components/diagrams/hooks/__tests__ src/components/diagrams/ui/__tests__ src/components/diagrams/collaboration/__tests__ src/components/warehouse-3d/__tests__",
    "test:ci:core-components": "npm run test:ci:core-components-a && npm run test:ci:core-components-b && npm run test:ci:core-components-c",
    "test:ci:core-components-a": "vitest run --maxWorkers=2 src/core/components/shared/__tests__ src/core/components/ui/__tests__ src/core/hooks/__tests__",
    "test:ci:core-components-b": "vitest run --maxWorkers=2 src/core/config/__tests__ src/core/themes/__tests__",
    "test:ci:core-components-c": "vitest run --maxWorkers=2 src/core/components/config/__tests__ src/core/components/custom-edges/hooks/__tests__ src/core/components/diagrams/hooks/__tests__ src/core/components/layout/__tests__",
    "test:ci:mindmap": "vitest run --maxWorkers=2 src/core/components/mindmap-v2/__tests__",
    "test:ci:routing": "npm run test:ci:routing-core && npm run test:ci:routing-services && npm run test:ci:routing-layout",
    "test:ci:routing-core": "vitest run --maxWorkers=2 src/core/factories/__tests__ src/core/plugins/__tests__ src/core/routing/__tests__ src/core/routing/algorithms/__tests__ src/core/routing/core/__tests__ src/core/routing/utils/__tests__",
    "test:ci:routing-services": "vitest run --maxWorkers=2 src/core/services/__tests__ src/core/strategies/shared/__tests__",
    "test:ci:routing-layout": "vitest run --maxWorkers=2 src/core/strategies/__tests__ src/core/utils/layout/__tests__",
    "test:all:lowcpu": "vitest run --maxWorkers=2",
    "test:coverage": "vitest run --coverage",
    "check:artifacts": "node scripts/check-tracked-artifacts.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:audit": "npm audit --omit=optional",
    "check:test-ci-coverage": "node scripts/check-test-ci-coverage.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "smoke:routes": "node scripts/smoke-routes.mjs",
    "smoke:routes:budget": "node scripts/smoke-routes.mjs",
    "smoke:routes:mobile": "node scripts/smoke-routes.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@aws-sdk/client-s3": "^3.1024.0",
    "@iconify/react": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@react-spring/web": "^10.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.101.1",
    "@types/d3-force": "^3.0.10",
    "@types/dagre": "^0.7.54",
    "@types/lodash": "^4.17.24",
    "@types/three": "^0.183.1",
    "@xyflow/react": "^12.10.2",
    "antd": "^6.3.5",
    "cytoscape": "^3.33.1",
    "cytoscape-fcose": "^2.2.0",
    "d3-force": "^3.0.0",
    "dagre": "^0.8.5",
    "elkjs": "^0.11.1",
    "fast-json-patch": "^3.1.1",
    "framer-motion": "^12.38.0",
    "gifshot": "^0.4.5",
    "html-to-image": "^1.11.13",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.4",
    "immer": "^11.1.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.7.0",
    "marked": "^18.0.2",
    "mind-elixir": "^5.11.0",
    "next-themes": "^0.4.6",
    "perfect-freehand": "^1.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-i18next": "^17.0.2",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.9.0",
    "react-resize-detector": "^12.3.0",
    "react-router-dom": "^7.14.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "roughjs": "^4.6.6",
    "three": "^0.183.2",
    "web-worker": "^1.5.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "dompurify": "^3.4.9"
  }
}
