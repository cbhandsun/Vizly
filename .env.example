# Copy to .env.local and configure your Supabase project before starting Vite.
# Use only a publishable key or legacy anon key; never a secret/service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Model requests go directly from the browser to the configured provider by default.
# Cloud documents/settings still use Supabase. Set auto/required only to opt into a gateway.
VITE_AI_GATEWAY_MODE=off

# Optional isolated AI gateway candidate in the same Supabase project.
# Empty uses the production ai-gateway function.
VITE_AI_GATEWAY_FUNCTION_NAME=
